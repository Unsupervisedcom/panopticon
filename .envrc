# Auto-activate the devenv shell on `cd` (direnv). `use devenv` is not a direnv builtin and the
# nix-direnv most people have does not define it, so pull the function from the devenv on PATH
# rather than pinning a hashed copy of it from the network.
if ! has devenv; then
  log_error "devenv is not installed — see https://devenv.sh/getting-started/"
  exit 1
fi

eval "$(devenv direnvrc)"

use devenv
